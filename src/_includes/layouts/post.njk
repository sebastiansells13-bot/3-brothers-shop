---
layout: layouts/base.njk
---
<article class="post">
  <header class="page-hero page-hero--short">
    <div class="wrapper">
      <p class="script">{{ tags | reject("equalto", "posts") | first | replace("-", " ") | capitalize }}</p>
      <h1>{{ title }}</h1>
      <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
    </div>
  </header>
  <div class="parchment">
    <div class="wrapper post__layout">
      {% if image %}<figure class="framed post__image"><img src="{{ image }}" alt=""></figure>{% endif %}
      <div class="post__body prose">
        {{ content | safe }}
        <p><a class="btn btn--ghost" href="/news/">&larr; All news</a></p>
      </div>
    </div>
  </div>
</article>
