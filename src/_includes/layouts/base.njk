{%- set siteName = business.name or metadata.title -%}
{%- set pageName = seoTitle or (title if title != "Home") -%}
{%- set pageTitle = (pageName + " · " + siteName) if pageName else siteName -%}
{%- set pageDescription = description or metadata.description -%}
{%- set pageUrl = metadata.url + page.url -%}
{%- set socialImage = metadata.url + (image or "/img/posts/open-tomorrow.jpg") -%}
<!doctype html>
<html lang="{{ metadata.language }}">
<head>
  <meta charset="utf-8">
  {% if isProduction %}<meta http-equiv="Content-Security-Policy" content="{{ contentSecurityPolicy }}">{% endif %}
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title{% if titleKey %} data-i18n-title="{{ titleKey }}"{% elif titleEs %} data-i18n-title-es="{{ titleEs }}"{% endif %}>{{ pageTitle }}</title>
  {# Hide the page until js/i18n.js has applied a saved Spanish choice, so English never flashes. #}
  <script>{{ i18nBootScript | safe }}</script>
  <meta name="description" content="{{ pageDescription }}">
  {% if noindex %}<meta name="robots" content="noindex">{% else %}<link rel="canonical" href="{{ pageUrl }}">{% endif %}
  <meta property="og:site_name" content="{{ siteName }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ socialImage }}">
  <meta property="og:image:alt" content="{{ imageAlt or (title if image) or 'The 3 Brothers Shop LLC grand opening flyer: new location at 130 S Main St' }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:locale:alternate" content="es_MX">
  {% if tags and "posts" in tags %}
  <meta property="og:type" content="article">
  <meta property="article:published_time" content="{{ page.date | htmlDateString }}">
  {% else %}
  <meta property="og:type" content="website">
  {% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#2a170c">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32.png">
  <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,600;0,700;1,400&family=Rye&family=Yellowtail&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ assetPaths.stylesheet }}">
  <script type="application/ld+json">{{ page | structuredData(business, metadata, { title: title, description: description, image: image, tags: tags }) | safe }}</script>
  <script src="{{ assetPaths.i18nScript }}" defer></script>
  <script src="{{ assetPaths.navScript }}" defer></script>
  {% if collections %}<link rel="alternate" href="/feed.xml" type="application/atom+xml" title="{{ business.name }}">{% endif %}
</head>
<body>
  <a class="skip-link" href="#main" data-i18n="skip.toContent">Skip to content</a>
  {% include "components/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "components/footer.njk" %}
  <script type="application/json" id="i18n-data">{{ i18n | jsonScript | safe }}</script>
</body>
</html>
