<!doctype html>
<html lang="{{ metadata.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title{% if titleKey %} data-i18n-title="{{ titleKey }}"{% elif titleEs %} data-i18n-title-es="{{ titleEs }}"{% endif %}>{% if title and title != "Home" %}{{ title }} · {% endif %}{{ business.name or metadata.title }}</title>
  {# Hide the page until js/i18n.js has applied a saved Spanish choice, so English never flashes. #}
  <script>try { if (localStorage.getItem("lang") === "es") document.documentElement.classList.add("i18n-pending"); } catch (e) {}</script>
  <style>.i18n-pending body { visibility: hidden; }</style>
  <meta name="description" content="{{ description or metadata.description }}">
  <meta property="og:title" content="{{ title or business.name }}">
  <meta property="og:description" content="{{ description or metadata.description }}">
  <meta property="og:image" content="{{ metadata.url }}{{ image or '/img/posts/open-tomorrow.jpg' }}">
  <meta property="og:type" content="website">
  <meta name="theme-color" content="#2a170c">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32.png">
  <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png">
  <link rel="canonical" href="{{ metadata.url }}{{ page.url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,600;0,700;1,400&family=Rye&family=Yellowtail&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ assetPaths.stylesheet }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Store",
    "name": {{ business.name | dump | safe }},
    "description": {{ business.tagline | dump | safe }},
    "url": "{{ metadata.url }}/",
    "image": "{{ metadata.url }}/img/brand/logo.jpg",
    "telephone": {{ business.phone | dump | safe }},
    "address": {{ business.address | dump | safe }},
    "sameAs": {{ business.social | compactValues | dump | safe }}
  }
  </script>
  {% if collections %}<link rel="alternate" href="/feed.xml" type="application/atom+xml" title="{{ business.name }}">{% endif %}
</head>
<body>
  <a class="skip-link" href="#main" data-i18n="skip.toContent">Skip to content</a>
  {% include "components/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "components/footer.njk" %}
  <script type="application/json" id="i18n-data">{{ i18n | dump | safe }}</script>
  <script>{% include "js/i18n.js" %}</script>
  <script>
    document.querySelector(".nav-toggle")?.addEventListener("click", (e) => {
      const open = document.body.classList.toggle("nav-open");
      e.currentTarget.setAttribute("aria-expanded", open);
    });
  </script>
</body>
</html>
