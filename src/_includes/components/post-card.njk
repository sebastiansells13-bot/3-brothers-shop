{% from "macros/bilingual.njk" import bilingual %}
<article class="post-card">
  <a href="{{ post.url }}">
    {% if post.data.image %}<img src="{{ post.data.image }}" alt="" loading="lazy">{% endif %}
    <div class="post-card__body">
      <time datetime="{{ post.date | htmlDateString }}" data-i18n-date>{{ post.date | readableDate }}</time>
      <h3>{{ bilingual(post.data.title, post.data.titleEs) }}</h3>
      <p>{{ bilingual(post.data.description, post.data.descriptionEs) }}</p>
    </div>
  </a>
</article>
