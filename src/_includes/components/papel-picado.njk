{# Decorative papel picado banner, echoing the shop's Día de los Muertos graphics. #}
<div class="papel-picado" aria-hidden="true">
  <svg class="papel-picado__string" viewBox="0 0 100 4" preserveAspectRatio="none"><path d="M0 1 Q50 4 100 1" fill="none" stroke="currentColor" stroke-width=".4"/></svg>
  <ul>
    {% for i in range(0, 30) %}
    <li class="flag flag--{{ loop.index0 % 6 }}">
      <svg viewBox="0 0 60 70"><path fill-rule="evenodd" d="M0 0H60V60L55 70 50 60 45 70 40 60 35 70 30 60 25 70 20 60 15 70 10 60 5 70 0 60Z M30 14a6 6 0 1 0 .01 0Z M30 30l8 8-8 8-8-8Z M10 10h6v6h-6Z M44 10h6v6h-6Z M10 44h6v6h-6Z M44 44h6v6h-6Z M14 28a3 3 0 1 0 .01 0Z M46 28a3 3 0 1 0 .01 0Z"/></svg>
    </li>
    {% endfor %}
  </ul>
</div>
