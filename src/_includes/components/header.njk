{% if home.announcement %}
<div class="announcement"><div class="wrapper">{{ home.announcement }}</div></div>
{% endif %}
<header class="site-header">
  <div class="wrapper">
    <a class="brand" href="/">
      <img class="brand__logo" src="/img/brand/logo.jpg" alt="" width="56" height="56">
      <span class="brand__text">
        <span class="brand__name">3 Brothers Shop</span>
        <span class="brand__sub">Rustic Furniture &amp; Imports</span>
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__bars" aria-hidden="true"></span><span class="visually-hidden">Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {% for item in navigation %}
        {% set active = page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %}
        <li><a href="{{ item.url }}"{% if active %} class="is-active" aria-current="page"{% endif %}>{{ item.text }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
{% include "components/papel-picado.njk" %}
