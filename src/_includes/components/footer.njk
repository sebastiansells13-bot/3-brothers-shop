<footer class="site-footer">
  {% include "components/papel-picado.njk" %}
  <div class="wrapper site-footer__grid">
    <div>
      <img class="site-footer__logo" src="/img/brand/logo.jpg" alt="3 Brothers Shop LLC logo" width="96" height="96" loading="lazy">
      <p class="script">¡Gracias por apoyar lo local!</p>
    </div>
    <div>
      <h2>Visit</h2>
      <p>{{ business.address }}<br>{{ business.neighborhood }}</p>
      <p><a href="{{ business.phone | telHref }}">{{ business.phone }}</a>{% if business.email %}<br><a href="mailto:{{ business.email }}">{{ business.email }}</a>{% endif %}</p>
    </div>
    <div>
      <h2>Hours</h2>
      {% if business.hours.length %}
      <ul class="hours">
        {% for row in business.hours %}<li><span>{{ row.days }}</span><span>{{ row.time }}</span></li>{% endfor %}
      </ul>
      {% else %}<p>{{ business.hoursNote }}</p>{% endif %}
    </div>
    <div>
      <h2>Follow</h2>
      <p>New arrivals and market days, posted first on social.</p>
      {% set socialClass = "social--stacked" %}{% include "components/social-links.njk" %}
    </div>
  </div>
  <div class="wrapper site-footer__legal">&copy; {% year %} {{ business.name }} · Owner: {{ business.owner }}</div>
</footer>
