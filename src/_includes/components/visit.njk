<section class="visit wood" id="visit">
  <div class="wrapper visit__grid">
    <div class="visit__card parchment-card">
      <p class="script">Ven a visitarnos</p>
      <h2>Visit the Shop</h2>
      <p class="visit__address"><strong>{{ business.address }}</strong><br>{{ business.neighborhood }}</p>
      <ul class="hours">
        {% for row in business.hours %}<li><span>{{ row.days }}</span><span>{{ row.time }}</span></li>{% endfor %}
      </ul>
      {% if business.hoursNote %}<p class="small">{{ business.hoursNote }}</p>{% endif %}
      <p class="btn-row">
        <a class="btn" href="https://www.google.com/maps/dir/?api=1&destination={{ business.address | mapQuery }}">Get directions</a>
        <a class="btn btn--ghost" href="{{ business.phone | telHref }}">Call {{ business.phone }}</a>
      </p>
    </div>
    <div class="visit__map framed">
      <iframe title="Map to {{ business.name }}" src="https://www.google.com/maps?q={{ business.address | mapQuery }}&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>
