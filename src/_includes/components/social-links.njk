{# Icon links to the shop's social accounts. Set `socialClass` before including for a variant. #}
{% set networks = [
  { key: "instagram", label: "Instagram", handle: "@3brothersshopllc" },
  { key: "tiktok", label: "TikTok", handle: "@3.brothers.llc" },
  { key: "facebook", label: "Facebook", handle: "Facebook" }
] %}
<ul class="social {{ socialClass }}">
  {% for n in networks %}{% if business.social[n.key] %}
  <li>
    <a href="{{ business.social[n.key] }}" rel="noopener" target="_blank" aria-label="{{ business.name }} on {{ n.label }}" data-i18n-attr="aria-label:social.on" data-i18n-vars="{{ { name: business.name, network: n.label } | dump }}">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        {% if n.key == "instagram" %}
        <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>
        {% elif n.key == "tiktok" %}
        <path fill="currentColor" d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48Z"/>
        {% else %}
        <path fill="currentColor" d="M14 8.5V11h3l-.5 3H14v8h-3.5v-8H8v-3h2.5V8.2C10.5 5.6 12 4 14.6 4c1.1 0 2.4.2 2.4.2v2.8h-1.4c-1.2 0-1.6.6-1.6 1.5Z"/>
        {% endif %}
      </svg>
      <span>{{ n.handle }}</span>
    </a>
  </li>
  {% endif %}{% endfor %}
</ul>
