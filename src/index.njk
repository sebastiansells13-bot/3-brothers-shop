---
layout: layouts/page.njk
title: Home
---
<section class="hero wood">
  <div class="wrapper hero__grid">
    <div class="hero__copy">
      <p class="script hero__eyebrow">{{ home.eyebrow }}</p>
      <h1 class="hero__title"><span>3 Brothers</span> Shop <small>LLC</small></h1>
      <p class="ribbon">{{ home.headline }}</p>
      <p class="hero__intro">{{ home.intro }}</p>
      <p class="btn-row">
        <a class="btn" href="/visit/">Visit us · 130 S Main St</a>
        <a class="btn btn--ghost-light" href="/shop/">What we carry</a>
      </p>
    </div>
    <div class="hero__art">
      <figure class="framed framed--tilt"><img src="{{ home.heroImage }}" alt="The hand-painted 3 Brothers Shop sign on the sidewalk" width="480" height="640"></figure>
      <img class="hero__badge" src="/img/brand/logo.jpg" alt="3 Brothers Shop LLC logo" width="150" height="150">
    </div>
  </div>
</section>

<section class="parchment section">
  <div class="wrapper">
    <header class="section-head">
      <p class="script">Lo que tenemos</p>
      <h2>What We Carry</h2>
    </header>
    <div class="category-grid">
      {% for category in categories.list %}{% include "components/category-card.njk" %}{% endfor %}
    </div>
    <p class="center"><a class="btn" href="/shop/">See the whole shop</a></p>
  </div>
</section>

<section class="feature">
  <div class="wrapper feature__grid">
    <figure class="framed framed--tilt-left"><img src="/img/gallery/catrinas.jpg" alt="Two tall catrina figures" loading="lazy" width="480" height="640"></figure>
    <div>
      <p class="script">Todo el año</p>
      <h2>Día de los Muertos, all year round</h2>
      <p>Catrinas, painted calaveras, marigold accents and everything for your ofrenda, plus the fall décor that sold out at the farmers market.</p>
      <a class="btn btn--light" href="/news/">See what's new</a>
    </div>
  </div>
</section>

<section class="parchment section">
  <div class="wrapper">
    <header class="section-head">
      <p class="script">Straight from our Instagram</p>
      <h2>Around the Shop</h2>
    </header>
    <div class="gallery">
      {% for item in gallery.list %}
      <figure><img src="{{ item.image }}" alt="{{ item.caption }}" loading="lazy"><figcaption>{{ item.caption }}</figcaption></figure>
      {% endfor %}
    </div>
    <p class="center"><a class="btn btn--ghost" href="{{ business.social.instagram }}">Follow @3brothersshopllc</a></p>
  </div>
</section>

<section class="section news-strip">
  <div class="wrapper">
    <header class="section-head section-head--light">
      <p class="script">Noticias</p>
      <h2>News &amp; Events</h2>
    </header>
    <div class="post-grid">
      {% for post in collections.posts | reverse | head(3) %}{% include "components/post-card.njk" %}{% endfor %}
    </div>
  </div>
</section>

{% include "components/visit.njk" %}
