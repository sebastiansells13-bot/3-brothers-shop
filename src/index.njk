---
layout: layouts/page.njk
title: Home
seoTitle: Rustic Furniture & Imports in Las Cruces, NM
titleKey: seo.home
---
{% from "macros/bilingual.njk" import bilingual %}
<section class="hero wood">
  <div class="wrapper hero__grid">
    <div class="hero__copy">
      <p class="script hero__eyebrow">{{ bilingual(home.eyebrow, home.eyebrowEs) }}</p>
      <h1 class="hero__title"><span>3 Brothers</span> Shop <small>LLC</small></h1>
      <p class="ribbon">{{ bilingual(home.headline, home.headlineEs) }}</p>
      <p class="hero__intro">{{ bilingual(home.intro, home.introEs) }}</p>
      <p class="btn-row">
        <a class="btn" href="/visit/" data-i18n="home.ctaVisit">Visit us · 130 S Main St</a>
        <a class="btn btn--ghost-light" href="/shop/" data-i18n="home.ctaShop">What we carry</a>
      </p>
    </div>
    <div class="hero__art">
      <figure class="framed framed--tilt"><img src="{{ home.heroImage }}" alt="The hand-painted 3 Brothers Shop sign on the sidewalk" data-i18n-attr="alt:home.heroAlt" width="480" height="640" fetchpriority="high"></figure>
      <img class="hero__badge" src="/img/brand/logo.jpg" alt="3 Brothers Shop LLC logo" data-i18n-attr="alt:brand.logoAlt" width="150" height="150">
    </div>
  </div>
</section>

<section class="parchment section">
  <div class="wrapper">
    <header class="section-head">
      <p class="script">Lo que tenemos</p>
      <h2 data-i18n="home.carryTitle">What We Carry</h2>
    </header>
    <div class="category-grid">
      {% for category in categories.list %}{% include "components/category-card.njk" %}{% endfor %}
    </div>
    <p class="center"><a class="btn" href="/shop/" data-i18n="home.seeAll">See the whole shop</a></p>
  </div>
</section>

<section class="feature">
  <div class="wrapper feature__grid">
    <figure class="framed framed--tilt-left"><img src="/img/gallery/catrinas.jpg" alt="Two tall catrina figures" data-i18n-attr="alt:home.featureAlt" loading="lazy" width="480" height="640"></figure>
    <div>
      <p class="script">Todo el año</p>
      <h2 data-i18n="home.featureTitle">Día de los Muertos, all year round</h2>
      <p data-i18n="home.featureBody">Catrinas, painted calaveras, marigold accents and everything for your ofrenda, plus the fall décor that sold out at the farmers market.</p>
      <a class="btn btn--light" href="/news/" data-i18n="home.featureCta">See what's new</a>
    </div>
  </div>
</section>

<section class="parchment section">
  <div class="wrapper">
    <header class="section-head">
      <p class="script">Síguenos en Instagram y TikTok</p>
      <h2 data-i18n="home.galleryTitle">Around the Shop</h2>
    </header>
    {% include "components/gallery.njk" %}
    <p class="btn-row btn-row--center">
      <a class="btn btn--ghost" href="{{ business.social.instagram | safeUrl }}" rel="noopener noreferrer" target="_blank">Instagram @3brothersshopllc</a>
      {% if business.social.tiktok %}<a class="btn btn--ghost" href="{{ business.social.tiktok | safeUrl }}" rel="noopener noreferrer" target="_blank">TikTok @3.brothers.llc</a>{% endif %}
    </p>
  </div>
</section>

<section class="section news-strip">
  <div class="wrapper">
    <header class="section-head section-head--light">
      <p class="script">Noticias</p>
      <h2 data-i18n="home.newsTitle">News &amp; Events</h2>
    </header>
    <div class="post-grid">
      {% for post in collections.posts | reverse | head(3) %}{% include "components/post-card.njk" %}{% endfor %}
    </div>
  </div>
</section>

{% include "components/visit.njk" %}
