---
layout: layouts/page.njk
title: About
titleKey: nav.about
description: The story of 3 Brothers Shop LLC, from the Las Cruces farmers market to Main Street.
permalink: /about/
---
{% from "macros/bilingual.njk" import bilingual %}
<header class="page-hero">
  <div class="wrapper">
    <p class="script">Nuestra historia</p>
    <h1 data-i18n="about.title">About the Shop</h1>
  </div>
</header>
<section class="parchment section">
  <div class="wrapper about__grid">
    <figure class="framed framed--tilt-left"><img src="{{ about.image }}" alt="3 Brothers Shop decorations and antiques logo" data-i18n-attr="alt:about.imageAlt" width="640" height="640"></figure>
    <div class="prose">
      <h2>{{ bilingual(about.heading, about.headingEs) }}</h2>
      {{ bilingual(about.body | markdown, about.bodyEs | markdown if about.bodyEs else "", "div", true) }}
      <p class="signature">— {{ business.owner }}, <span data-i18n="about.owner">owner</span></p>
    </div>
  </div>
</section>
<section class="section news-strip">
  <div class="wrapper">
    <header class="section-head section-head--light">
      <p class="script">Desde el mercado</p>
      <h2 data-i18n="about.timelineTitle">From the Farmers Market to Main Street</h2>
    </header>
    <div class="timeline">
      <figure><img src="/img/posts/farmers-market-flyer-2.jpg" alt="We're at the Farmers Market flyer" data-i18n-attr="alt:about.step1Alt" loading="lazy"><figcaption data-i18n="about.step1">At the Farmers &amp; Crafts Market</figcaption></figure>
      <figure><img src="/img/posts/coming-soon.jpg" alt="Coming soon, new location flyer" data-i18n-attr="alt:about.step2Alt" loading="lazy"><figcaption data-i18n="about.step2">A new location announced</figcaption></figure>
      <figure><img src="/img/posts/open-tomorrow.jpg" alt="Open tomorrow at 130 S Main St flyer" data-i18n-attr="alt:about.step3Alt" loading="lazy"><figcaption data-i18n="about.step3">Open at 130 S Main St</figcaption></figure>
    </div>
  </div>
</section>
{% include "components/visit.njk" %}
